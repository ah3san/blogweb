---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

// Extract all unique technologies for a potential filter list if needed
const allTech = [...new Set(projects.flatMap(p => p.tech))].sort();
const categories = ['Cybersecurity', 'AI', 'Programming', 'Tools'];
---

<Layout
  title="Projects Showcase | Novexa.tech"
  description="Explore technical projects, open source security tools, decentralized blockchain protocols, and local AI agent software."
>
  <div class="py-12 bg-slate-50/50 dark:bg-[#070a13] border-b border-slate-200/50 dark:border-slate-800/50 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Technical Showcase
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed font-light">
        A catalog of active systems programming experiments, AI SDKs, security audit tooling, and client libraries.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Filters (Search & Category Buttons) -->
    <div class="space-y-6 mb-10">
      <!-- Search Input -->
      <div class="relative max-w-xl">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </span>
        <input
          type="text"
          id="project-search"
          placeholder="Search projects by name, description, or technology..."
          class="w-full pl-10 pr-4 py-3 bg-white dark:bg-[#0c101e] border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-white rounded-xl focus:outline-none focus:border-cyan-500 transition-colors shadow-sm text-sm"
        />
      </div>

      <!-- Categories filters -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mr-2">Category:</span>
        <button
          class="proj-cat-btn px-4 py-1.5 rounded-lg text-xs font-semibold border transition-all cursor-pointer bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white"
          data-category="all"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            class="proj-cat-btn px-4 py-1.5 rounded-lg text-xs font-semibold border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:border-cyan-500/50 hover:text-cyan-500 transition-all cursor-pointer bg-white dark:bg-[#0c101e]"
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <div
          class="project-item"
          data-name={project.name.toLowerCase()}
          data-description={project.description.toLowerCase()}
          data-category={project.category}
          data-tech={project.tech.join(',').toLowerCase()}
        >
          <ProjectCard project={project} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="projects-empty-state" class="hidden text-center py-20 space-y-4">
      <div class="inline-flex p-4 rounded-full bg-slate-100 dark:bg-slate-900 text-slate-400 border border-slate-200/50 dark:border-slate-800 mb-2">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">No projects found</h3>
      <p class="text-slate-500 dark:text-slate-400 max-w-sm mx-auto text-sm leading-relaxed">
        No projects match the search query or category filters. Try resetting the options.
      </p>
      <button id="projects-reset-btn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-lg text-xs transition-colors cursor-pointer">
        Reset filters
      </button>
    </div>
  </div>

  <script>
    // Client-side filtering logic
    const searchInput = document.getElementById('project-search') as HTMLInputElement;
    const categoryButtons = document.querySelectorAll('.proj-cat-btn');
    const projectItems = document.querySelectorAll('.project-item');
    const gridContainer = document.getElementById('projects-grid');
    const emptyState = document.getElementById('projects-empty-state');
    const resetBtn = document.getElementById('projects-reset-btn');

    let selectedCategory = 'all';
    let searchQuery = '';

    function filterProjects() {
      let visibleCount = 0;

      projectItems.forEach(item => {
        const name = item.getAttribute('data-name') || '';
        const description = item.getAttribute('data-description') || '';
        const category = item.getAttribute('data-category') || '';
        const tech = item.getAttribute('data-tech') || '';

        const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
        const matchesSearch = !searchQuery || 
          name.includes(searchQuery) || 
          description.includes(searchQuery) || 
          tech.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          (item as HTMLElement).classList.remove('hidden');
          visibleCount++;
        } else {
          (item as HTMLElement).classList.add('hidden');
        }
      });

      // Update empty state
      if (emptyState && gridContainer) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          gridContainer.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          gridContainer.classList.remove('hidden');
        }
      }
    }

    function updateButtonUI() {
      categoryButtons.forEach(btn => {
        const cat = btn.getAttribute('data-category');
        if (cat === selectedCategory) {
          btn.className = "proj-cat-btn px-4 py-1.5 rounded-lg text-xs font-semibold border transition-all cursor-pointer bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white";
        } else {
          btn.className = "proj-cat-btn px-4 py-1.5 rounded-lg text-xs font-semibold border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:border-cyan-500/50 hover:text-cyan-500 transition-all cursor-pointer bg-white dark:bg-[#0c101e]";
        }
      });
    }

    // Search events
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      filterProjects();
    });

    // Category button events
    categoryButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        selectedCategory = btn.getAttribute('data-category') || 'all';
        updateButtonUI();
        filterProjects();
      });
    });

    // Reset button events
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        selectedCategory = 'all';
        searchQuery = '';
        searchInput.value = '';
        updateButtonUI();
        filterProjects();
      });
    }
  </script>
</Layout>
