---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

// Get and sort blog posts
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get all unique tags
const allTags = [...new Set(sortedPosts.flatMap(post => post.data.tags))].sort();

const categories = ['Cybersecurity', 'Programming', 'AI', 'Linux', 'Windows', 'Tools', 'Research'];
---

<Layout
  title="Blog Articles | Novexa.tech"
  description="Browse articles on cybersecurity exploitation, systems programming, local AI agents, and DevOps security workflows."
>
  <div class="py-12 bg-slate-50/50 dark:bg-[#070a13] border-b border-slate-200/50 dark:border-slate-800/50 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Technical Publications
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed font-light">
        Search and filter through tutorials, vulnerability analyses, and open-source project documents.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Controls (Search & Category Filters) -->
    <div class="space-y-6 mb-10">
      <!-- Search Input -->
      <div class="relative max-w-xl">
        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </span>
        <input
          type="text"
          id="blog-search"
          placeholder="Search articles by title, description, or tags..."
          class="w-full pl-10 pr-4 py-3 bg-white dark:bg-[#0c101e] border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-white rounded-xl focus:outline-none focus:border-cyan-500 transition-colors shadow-sm text-sm"
        />
      </div>

      <!-- Categories filters -->
      <div class="flex flex-wrap gap-2 items-center">
        <span class="text-xs font-semibold text-slate-400 dark:text-slate-500 uppercase tracking-wider mr-2">Category:</span>
        <button
          class="category-btn px-4 py-1.5 rounded-lg text-xs font-semibold border transition-all cursor-pointer bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white"
          data-category="all"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            class="category-btn px-4 py-1.5 rounded-lg text-xs font-semibold border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:border-cyan-500/50 hover:text-cyan-500 transition-all cursor-pointer bg-white dark:bg-[#0c101e]"
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Tag Indicator (hidden unless a tag is selected) -->
      <div id="tag-filter-indicator" class="hidden items-center gap-2 text-sm text-slate-600 dark:text-slate-400">
        <span>Filtering by tag:</span>
        <span id="active-tag-name" class="px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-500 border border-cyan-500/20 font-medium text-xs"></span>
        <button id="clear-tag-btn" class="text-xs text-slate-400 hover:text-red-400 transition-colors underline cursor-pointer">
          Clear tag
        </button>
      </div>
    </div>

    <!-- Articles Grid -->
    <div id="articles-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sortedPosts.map((post) => (
        <div
          class="article-item"
          data-title={post.data.title.toLowerCase()}
          data-description={post.data.description.toLowerCase()}
          data-category={post.data.category}
          data-tags={post.data.tags.join(',').toLowerCase()}
        >
          <ArticleCard post={post} />
        </div>
      ))}
    </div>

    <!-- Empty State -->
    <div id="empty-state" class="hidden text-center py-20 space-y-4">
      <div class="inline-flex p-4 rounded-full bg-slate-100 dark:bg-slate-900 text-slate-400 border border-slate-200/50 dark:border-slate-800 mb-2">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-slate-900 dark:text-white">No articles found</h3>
      <p class="text-slate-500 dark:text-slate-400 max-w-sm mx-auto text-sm leading-relaxed">
        We couldn't find any articles matching your search or filters. Try adjusting your queries.
      </p>
      <button id="reset-filters-btn" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-700 dark:text-slate-300 font-semibold rounded-lg text-xs transition-colors cursor-pointer">
        Reset all filters
      </button>
    </div>
  </div>

  <script>
    // Filtering logic
    const searchInput = document.getElementById('blog-search') as HTMLInputElement;
    const categoryButtons = document.querySelectorAll('.category-btn');
    const articleItems = document.querySelectorAll('.article-item');
    const container = document.getElementById('articles-container');
    const emptyState = document.getElementById('empty-state');
    const tagIndicator = document.getElementById('tag-filter-indicator');
    const activeTagName = document.getElementById('active-tag-name');
    const clearTagBtn = document.getElementById('clear-tag-btn');
    const resetFiltersBtn = document.getElementById('reset-filters-btn');

    let currentCategory = 'all';
    let currentSearch = '';
    let currentTag = '';

    // Initialize state from URL params
    function initFromUrl() {
      const params = new URLSearchParams(window.location.search);
      const cat = params.get('category');
      const tag = params.get('tag');
      const q = params.get('search');

      if (cat) currentCategory = cat;
      if (tag) currentTag = tag.toLowerCase();
      if (q) {
        currentSearch = q.toLowerCase();
        searchInput.value = q;
      }

      updateCategoryButtonsUI();
      updateTagIndicatorUI();
      applyFilters();
    }

    function updateCategoryButtonsUI() {
      categoryButtons.forEach(btn => {
        const cat = btn.getAttribute('data-category');
        if (cat === currentCategory) {
          btn.className = "category-btn px-4 py-1.5 rounded-lg text-xs font-semibold border transition-all cursor-pointer bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white";
        } else {
          btn.className = "category-btn px-4 py-1.5 rounded-lg text-xs font-semibold border border-slate-200/80 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:border-cyan-500/50 hover:text-cyan-500 transition-all cursor-pointer bg-white dark:bg-[#0c101e]";
        }
      });
    }

    function updateTagIndicatorUI() {
      if (tagIndicator && activeTagName) {
        if (currentTag) {
          activeTagName.textContent = `#${currentTag}`;
          tagIndicator.classList.remove('hidden');
          tagIndicator.classList.add('flex');
        } else {
          tagIndicator.classList.remove('flex');
          tagIndicator.classList.add('hidden');
        }
      }
    }

    function applyFilters() {
      let visibleCount = 0;

      articleItems.forEach(item => {
        const title = item.getAttribute('data-title') || '';
        const description = item.getAttribute('data-description') || '';
        const category = item.getAttribute('data-category') || '';
        const tags = item.getAttribute('data-tags') || '';

        const matchesCategory = currentCategory === 'all' || category === currentCategory;
        const matchesTag = !currentTag || tags.split(',').includes(currentTag);
        const matchesSearch = !currentSearch || 
          title.includes(currentSearch) || 
          description.includes(currentSearch) || 
          tags.includes(currentSearch);

        if (matchesCategory && matchesTag && matchesSearch) {
          (item as HTMLElement).classList.remove('hidden');
          visibleCount++;
        } else {
          (item as HTMLElement).classList.add('hidden');
        }
      });

      // Update empty state
      if (emptyState && container) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          container.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          container.classList.remove('hidden');
        }
      }
    }

    function updateUrl() {
      const url = new URL(window.location.href);
      
      if (currentCategory !== 'all') {
        url.searchParams.set('category', currentCategory);
      } else {
        url.searchParams.delete('category');
      }

      if (currentTag) {
        url.searchParams.set('tag', currentTag);
      } else {
        url.searchParams.delete('tag');
      }

      if (currentSearch) {
        url.searchParams.set('search', currentSearch);
      } else {
        url.searchParams.delete('search');
      }

      window.history.replaceState({}, '', url.toString());
    }

    // Event Listeners
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.toLowerCase();
      applyFilters();
      updateUrl();
    });

    categoryButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        currentCategory = btn.getAttribute('data-category') || 'all';
        updateCategoryButtonsUI();
        applyFilters();
        updateUrl();
      });
    });

    if (clearTagBtn) {
      clearTagBtn.addEventListener('click', () => {
        currentTag = '';
        updateTagIndicatorUI();
        applyFilters();
        updateUrl();
      });
    }

    if (resetFiltersBtn) {
      resetFiltersBtn.addEventListener('click', () => {
        currentCategory = 'all';
        currentSearch = '';
        currentTag = '';
        searchInput.value = '';
        updateCategoryButtonsUI();
        updateTagIndicatorUI();
        applyFilters();
        updateUrl();
      });
    }

    // Set up live listener for history changes (like clicking a tag on cards)
    window.addEventListener('popstate', initFromUrl);

    // Initial load
    initFromUrl();
  </script>
</Layout>
