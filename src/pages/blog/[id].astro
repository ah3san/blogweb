---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { getReadingTime } from '../../utils/readingTime';

// 1. Get Static Paths
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  
  return sorted.map((post, index) => {
    const prevPost = index < sorted.length - 1 ? sorted[index + 1] : null;
    const nextPost = index > 0 ? sorted[index - 1] : null;
    return {
      params: { id: post.id },
      props: { post, prevPost, nextPost },
    };
  });
}

const { post, prevPost, nextPost } = Astro.props;
const { title, description, pubDate, author, category, tags, heroImage } = post.data;

// 2. Render Markdown content and headings
const { Content, headings } = await render(post);

// Compute reading time
const readingTime = getReadingTime(post.body || '');

// Format date
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Sharing links
const encodedUrl = encodeURIComponent(Astro.url.href);
const encodedTitle = encodeURIComponent(title);
const xShare = `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`;
const linkedinShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`;
const facebookShare = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`;
const emailShare = `mailto:?subject=${encodedTitle}&body=Check%20out%20this%20article%20on%20Novexa.tech:%20${encodedUrl}`;
---

<Layout
  title={`${title} | Novexa.tech`}
  description={description}
  ogImage={heroImage}
  articleDate={pubDate}
  articleAuthor={author}
  articleCategory={category}
  articleTags={tags}
  isArticle={true}
>
  <!-- Reading Progress Bar -->
  <div id="progress-bar" class="fixed top-16 left-0 h-1 bg-gradient-to-r from-cyan-500 to-blue-500 w-0 z-50 transition-all duration-75"></div>

  <!-- Header Banner -->
  <div class="w-full bg-slate-50 dark:bg-[#070a13] border-b border-slate-200/50 dark:border-slate-800/50 py-12 md:py-16 transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-4">
      <div class="space-y-4">
        <!-- Back Link -->
        <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-cyan-500 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Articles
        </a>

        <!-- Category & Reading info -->
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
          <span class="px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-500 border border-cyan-500/20 font-bold uppercase tracking-wider text-[10px]">
            {category}
          </span>
          <span>&bull;</span>
          <span>{readingTime}</span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white leading-tight tracking-tight">
          {title}
        </h1>

        <!-- Author / Date -->
        <div class="flex items-center gap-3 pt-2 text-sm text-slate-600 dark:text-slate-400">
          <div class="w-8 h-8 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white font-bold text-xs">
            {author.charAt(0)}
          </div>
          <div>
            <p class="font-semibold text-slate-900 dark:text-slate-200">{author}</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Published on {formattedDate}</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Body Layout -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Sticky Sidebar (Table of Contents & Social sharing) -->
      <aside class="lg:col-span-3 lg:block hidden space-y-8 sticky top-28 self-start max-h-[80vh] overflow-y-auto pr-4">
        {headings.length > 0 && (
          <div class="space-y-3">
            <h4 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">On This Page</h4>
            <nav class="space-y-2 text-sm">
              {headings.map((heading) => {
                const padding = heading.depth === 3 ? 'pl-4 text-xs' : heading.depth === 4 ? 'pl-8 text-[11px]' : '';
                return (
                  <a
                    href={`#${heading.slug}`}
                    class={`block text-slate-600 dark:text-slate-400 hover:text-cyan-500 dark:hover:text-cyan-400 transition-colors leading-relaxed ${padding}`}
                  >
                    {heading.text}
                  </a>
                );
              })}
            </nav>
          </div>
        )}

        <!-- Social Share Sidebar -->
        <div class="space-y-3 pt-4 border-t border-slate-200/50 dark:border-slate-800/50">
          <h4 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">Share Article</h4>
          <div class="flex gap-3">
            <!-- X Share -->
            <a href={xShare} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors text-slate-600 dark:text-slate-400 dark:hover:text-cyan-400 hover:text-cyan-500" title="Share on X">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <!-- LinkedIn Share -->
            <a href={linkedinShare} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors text-slate-600 dark:text-slate-400 dark:hover:text-cyan-400 hover:text-cyan-500" title="Share on LinkedIn">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <!-- Facebook Share -->
            <a href={facebookShare} target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors text-slate-600 dark:text-slate-400 dark:hover:text-cyan-400 hover:text-cyan-500" title="Share on Facebook">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
            </a>
            <!-- Email Share -->
            <a href={emailShare} class="p-2 rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 transition-colors text-slate-600 dark:text-slate-400 dark:hover:text-cyan-400 hover:text-cyan-500" title="Share via Email">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </a>
          </div>
        </div>
      </aside>

      <!-- Content Core (Article Content) -->
      <article class="lg:col-span-9 space-y-8">
        <!-- Featured Image -->
        {heroImage && (
          <div class="rounded-2xl overflow-hidden aspect-video border border-slate-200/50 dark:border-slate-800/50 bg-slate-100 dark:bg-slate-900 shadow-sm">
            <img src={heroImage} alt={title} class="w-full h-full object-cover" />
          </div>
        )}

        <!-- Article Markdown Render -->
        <div class="prose dark:prose-invert max-w-none prose-slate prose-headings:font-bold prose-a:text-cyan-500 prose-code:font-mono prose-pre:rounded-xl prose-img:rounded-xl leading-relaxed text-slate-700 dark:text-slate-300">
          <Content />
        </div>

        <!-- Tags list -->
        <div class="flex flex-wrap gap-2 pt-6 border-t border-slate-200/50 dark:border-slate-800/50">
          {tags.map((tag) => (
            <a
              href={`/blog?tag=${encodeURIComponent(tag)}`}
              class="text-xs px-2.5 py-1 rounded bg-slate-100 hover:bg-cyan-500/10 hover:text-cyan-500 dark:bg-slate-800/60 dark:hover:bg-cyan-500/15 dark:hover:text-cyan-400 text-slate-600 dark:text-slate-400 font-semibold transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>

        <!-- Post Navigation (Previous / Next) -->
        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-8 border-t border-slate-200/50 dark:border-slate-800/50">
          {prevPost ? (
            <a
              href={`/blog/${prevPost.id}`}
              class="group flex flex-col p-4 rounded-xl border border-slate-200/60 dark:border-slate-800/60 hover:border-cyan-500/30 transition-all text-left"
            >
              <span class="text-[10px] text-slate-400 uppercase tracking-widest mb-1 font-bold">Older Article</span>
              <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-cyan-500 dark:group-hover:text-cyan-400 line-clamp-1 transition-colors">
                {prevPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block"></div>
          )}

          {nextPost ? (
            <a
              href={`/blog/${nextPost.id}`}
              class="group flex flex-col p-4 rounded-xl border border-slate-200/60 dark:border-slate-800/60 hover:border-cyan-500/30 transition-all text-right"
            >
              <span class="text-[10px] text-slate-400 uppercase tracking-widest mb-1 font-bold">Newer Article</span>
              <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-cyan-500 dark:group-hover:text-cyan-400 line-clamp-1 transition-colors">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div></div>
          )}
        </nav>
      </article>

    </div>
  </div>

  <!-- Styling is handled in global.css to avoid Tailwind v4 reference issues -->

  <script>
    // 1. Reading Progress Bar
    const progressBar = document.getElementById('progress-bar');
    if (progressBar) {
      window.addEventListener('scroll', () => {
        const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        const scrolled = (winScroll / height) * 100;
        progressBar.style.width = scrolled + '%';
      });
    }

    // 2. Copy Code Block Setup
    const preBlocks = document.querySelectorAll('article pre');
    preBlocks.forEach((pre) => {
      // Create copy button
      const button = document.createElement('button');
      button.className = 'code-copy-btn';
      button.textContent = 'Copy';
      
      // Inject button
      pre.appendChild(button);

      button.addEventListener('click', async () => {
        // Find the code block text (excluding the button text itself)
        const codeElement = pre.querySelector('code');
        const text = codeElement ? codeElement.innerText : pre.innerText.replace('Copy', '').trim();
        
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = 'Copied!';
          button.classList.add('text-emerald-400', 'border-emerald-600/40');
          
          setTimeout(() => {
            button.textContent = 'Copy';
            button.classList.remove('text-emerald-400', 'border-emerald-600/40');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
          button.textContent = 'Failed';
        }
      });
    });
  </script>
</Layout>
