---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection } from 'astro:content';

// Get and sort blog posts
const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Featured / Pinned posts
const pinnedPosts = sortedPosts.filter(post => post.data.pinned).slice(0, 2);
// Latest posts (exclude pinned to avoid duplicates, or show all if needed. Let's show top 3 latest)
const latestPosts = sortedPosts.slice(0, 3);

// Categories definitions
const categories = [
  { name: 'Cybersecurity', count: allPosts.filter(p => p.data.category === 'Cybersecurity').length, color: 'text-red-500 bg-red-500/10 hover:border-red-500/30', desc: 'Exploit audits & Web3 security' },
  { name: 'Programming', count: allPosts.filter(p => p.data.category === 'Programming').length, color: 'text-blue-500 bg-blue-500/10 hover:border-blue-500/30', desc: 'TypeScript, Go & systems engineering' },
  { name: 'AI', count: allPosts.filter(p => p.data.category === 'AI').length, color: 'text-purple-500 bg-purple-500/10 hover:border-purple-500/30', desc: 'Local LLMs, fine-tuning & agents' },
  { name: 'Linux', count: allPosts.filter(p => p.data.category === 'Linux').length, color: 'text-amber-500 bg-amber-500/10 hover:border-amber-500/30', desc: 'OS hardening & administration' },
  { name: 'Windows', count: allPosts.filter(p => p.data.category === 'Windows').length, color: 'text-sky-500 bg-sky-500/10 hover:border-sky-500/30', desc: 'OS diagnostics & troubleshooting' },
  { name: 'Tools', count: allPosts.filter(p => p.data.category === 'Tools').length, color: 'text-emerald-500 bg-emerald-500/10 hover:border-emerald-500/30', desc: 'Bug bounty scripts & developer kits' },
  { name: 'Research', count: allPosts.filter(p => p.data.category === 'Research').length, color: 'text-cyan-500 bg-cyan-500/10 hover:border-cyan-500/30', desc: 'Vulnerability analysis & zero-days' },
];
---

<Layout>
  <!-- Hero Section -->
  <section class="relative pt-20 pb-16 md:pt-32 md:pb-24 overflow-hidden bg-grid-pattern dark:bg-grid-pattern-dark">
    <!-- Ambient glowing backgrounds -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-full max-w-7xl h-96 bg-gradient-to-r from-cyan-500/5 via-blue-500/5 to-purple-500/5 blur-3xl pointer-events-none rounded-full"></div>
    
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10 space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-900 border border-slate-200/60 dark:border-slate-800/80 text-xs font-semibold text-slate-600 dark:text-slate-400">
        <span class="w-2 h-2 rounded-full bg-cyan-500 animate-pulse"></span>
        Deep Technical Insights & Research
      </div>
      
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight leading-tight max-w-4xl mx-auto text-slate-900 dark:text-white">
        Building Secure Systems, <span class="bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-500 bg-clip-text text-transparent">AI Integrations</span>, & Open Source.
      </h1>
      
      <p class="text-base sm:text-xl text-slate-600 dark:text-slate-400 max-w-2xl mx-auto leading-relaxed font-light">
        A cybersecurity, programming, and AI research publication. Sharing production-ready guides, security audits, and developer tools.
      </p>

      <div class="pt-4 flex flex-wrap justify-center gap-4">
        <a
          href="/blog"
          class="px-6 py-3 bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-white font-semibold rounded-xl text-sm transition-all duration-300 transform active:scale-95 shadow-md shadow-cyan-500/10 cursor-pointer"
        >
          Read Articles
        </a>
        <a
          href="/projects"
          class="px-6 py-3 bg-white hover:bg-slate-50 dark:bg-slate-900 dark:hover:bg-slate-800/80 text-slate-800 dark:text-white border border-slate-200 dark:border-slate-800 font-semibold rounded-xl text-sm transition-all duration-300 transform active:scale-95 cursor-pointer"
        >
          Explore Projects
        </a>
        <a
          href="/contact"
          class="px-6 py-3 bg-transparent hover:text-cyan-500 dark:hover:text-cyan-400 text-slate-600 dark:text-slate-300 font-medium rounded-xl text-sm transition-colors cursor-pointer"
        >
          Contact Me &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-12 border-y border-slate-200/50 dark:border-slate-800/50 bg-white dark:bg-[#080b14] transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <h2 class="text-xs font-bold text-cyan-500 uppercase tracking-widest">Explore by Domain</h2>
        <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Curated Categories</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={`/blog?category=${encodeURIComponent(cat.name)}`}
            class={`flex flex-col p-6 rounded-2xl border border-slate-200/60 dark:border-slate-800/60 bg-slate-50/50 dark:bg-[#0c101e] transition-all duration-300 hover:-translate-y-1 hover:shadow-sm ${cat.color}`}
          >
            <div class="flex justify-between items-center mb-3">
              <h3 class="font-bold text-lg text-slate-900 dark:text-white">{cat.name}</h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-200/60 dark:bg-slate-800/80 text-slate-500 dark:text-slate-400">
                {cat.count} {cat.count === 1 ? 'post' : 'posts'}
              </span>
            </div>
            <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
              {cat.desc}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Pinned Articles Section -->
  {pinnedPosts.length > 0 && (
    <section class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div class="space-y-1">
          <h2 class="text-xs font-bold text-cyan-500 uppercase tracking-widest">Research Spotlights</h2>
          <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Featured Publications</p>
        </div>
        <a href="/blog" class="text-sm font-semibold text-cyan-500 hover:text-cyan-400 transition-colors flex items-center gap-1">
          All articles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {pinnedPosts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </section>
  )}

  <!-- Latest Articles Section -->
  <section class="py-16 bg-slate-50/50 dark:bg-[#070a13] border-t border-slate-200/50 dark:border-slate-800/50 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8">
        <div class="space-y-1">
          <h2 class="text-xs font-bold text-cyan-500 uppercase tracking-widest">Recent Writeups</h2>
          <p class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">Latest Tech Tutorials</p>
        </div>
        <a href="/blog" class="text-sm font-semibold text-cyan-500 hover:text-cyan-400 transition-colors flex items-center gap-1">
          Browse Blog
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {latestPosts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- Newsletter CTA Section -->
  <section class="py-16 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <Newsletter />
  </section>
</Layout>
