---
import Layout from '../layouts/Layout.astro';

const contactMethods = [
  {
    name: 'Email Address',
    value: 'ahsan@novexa.tech',
    link: 'mailto:ahsan@novexa.tech',
    icon: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    name: 'GitHub Profile',
    value: 'github.com/novexa',
    link: 'https://github.com/novexa',
    icon: 'M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4M9 18c-4.51 2-5-2-7-2'
  },
  {
    name: 'LinkedIn Profile',
    value: 'linkedin.com/in/ahsan-habib',
    link: 'https://linkedin.com',
    icon: 'M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z M4 6a2 2 0 110-4 2 2 0 010 4z'
  },
  {
    name: 'X / Twitter',
    value: '@novexa_tech',
    link: 'https://x.com',
    icon: 'M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z'
  }
];
---

<Layout
  title="Contact Ahsan | Novexa.tech"
  description="Get in touch with Ahsan Habib for software development, system troubleshooting, or security audits. Submit your messages directly."
>
  <div class="py-12 bg-slate-50/50 dark:bg-[#070a13] border-b border-slate-200/50 dark:border-slate-800/50 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 dark:text-white tracking-tight">
        Get In Touch
      </h1>
      <p class="text-slate-600 dark:text-slate-400 max-w-2xl leading-relaxed font-light">
        Reach out for security consulting audits, open source inquiries, or technical questions.
      </p>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Contact details -->
      <div class="lg:col-span-5 space-y-8">
        <div class="space-y-4">
          <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white">Communication Channels</h2>
          <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
            Feel free to contact me via any of the social platforms below or drop a secure email. I usually respond within 24–48 hours.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-4">
          {contactMethods.map((method) => (
            <a
              href={method.link}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 p-4 rounded-xl border border-slate-200/60 dark:border-slate-800/60 bg-white dark:bg-[#0c101e] hover:border-cyan-500/20 hover:shadow-sm transition-all"
            >
              <div class="p-3 rounded-lg bg-cyan-500/10 text-cyan-500">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={method.icon}></path>
                </svg>
              </div>
              <div>
                <h4 class="text-xs font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">{method.name}</h4>
                <p class="text-sm font-semibold text-slate-800 dark:text-slate-200">{method.value}</p>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Contact form -->
      <div class="lg:col-span-7">
        <div class="bg-white dark:bg-[#0c101e] border border-slate-200/60 dark:border-slate-800/60 rounded-2xl p-6 sm:p-8 shadow-sm">
          <h2 class="text-xl font-bold text-slate-900 dark:text-white mb-6">Send a Message</h2>
          
          <form id="contact-form" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="contact-name" class="text-xs font-semibold text-slate-500 dark:text-slate-400">Full Name</label>
                <input
                  type="text"
                  id="contact-name"
                  required
                  placeholder="John Doe"
                  class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-white placeholder-slate-400 rounded-xl focus:outline-none focus:border-cyan-500 transition-colors text-sm"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-email" class="text-xs font-semibold text-slate-500 dark:text-slate-400">Email Address</label>
                <input
                  type="email"
                  id="contact-email"
                  required
                  placeholder="john@example.com"
                  class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-white placeholder-slate-400 rounded-xl focus:outline-none focus:border-cyan-500 transition-colors text-sm"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="contact-subject" class="text-xs font-semibold text-slate-500 dark:text-slate-400">Subject</label>
              <input
                type="text"
                id="contact-subject"
                required
                placeholder="Inquiry regarding audit / contract..."
                class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-white placeholder-slate-400 rounded-xl focus:outline-none focus:border-cyan-500 transition-colors text-sm"
              />
            </div>

            <div class="space-y-1.5">
              <label for="contact-message" class="text-xs font-semibold text-slate-500 dark:text-slate-400">Message Content</label>
              <textarea
                id="contact-message"
                required
                rows="5"
                placeholder="Write your details or questions here..."
                class="w-full px-4 py-2.5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800 text-slate-800 dark:text-white placeholder-slate-400 rounded-xl focus:outline-none focus:border-cyan-500 transition-colors text-sm resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-white font-semibold rounded-xl text-sm transition-all duration-300 transform active:scale-95 cursor-pointer"
            >
              Send Secure Message
            </button>

            <!-- Status Indicator -->
            <div id="contact-status" class="hidden text-sm text-center mt-3 font-medium transition-all"></div>
          </form>
        </div>
      </div>

    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const nameInput = document.getElementById('contact-name') as HTMLInputElement;
    const emailInput = document.getElementById('contact-email') as HTMLInputElement;
    const subjectInput = document.getElementById('contact-subject') as HTMLInputElement;
    const messageInput = document.getElementById('contact-message') as HTMLTextAreaElement;
    const statusDiv = document.getElementById('contact-status') as HTMLDivElement;

    if (form && statusDiv) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Basic inputs check
        const name = nameInput.value.trim();
        const email = emailInput.value.trim();
        const subject = subjectInput.value.trim();
        const message = messageInput.value.trim();

        if (!name || !email || !subject || !message) return;

        // Display sending state
        statusDiv.className = "text-cyan-500 font-semibold text-center mt-3";
        statusDiv.textContent = "Encrypting and transmitting payload...";
        statusDiv.classList.remove('hidden');

        // Simulate network transmit success
        setTimeout(() => {
          statusDiv.className = "text-emerald-500 font-semibold text-center mt-3";
          statusDiv.textContent = "Message sent successfully! I will reach out shortly.";
          form.reset();
          
          setTimeout(() => {
            statusDiv.classList.add('hidden');
          }, 5000);
        }, 1500);
      });
    }
  </script>
</Layout>
