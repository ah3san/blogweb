---
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '../utils/readingTime';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, tags, heroImage } = post.data;

// Compute reading time
const readingTime = getReadingTime(post.body || '');

// Format date
const formattedDate = new Date(pubDate).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Category Colors Map
const categoryColors: Record<string, string> = {
  Cybersecurity: 'bg-red-500/10 text-red-500 border-red-500/20',
  Programming: 'bg-blue-500/10 text-blue-500 border-blue-500/20',
  AI: 'bg-purple-500/10 text-purple-500 border-purple-500/20',
  Linux: 'bg-amber-500/10 text-amber-500 border-amber-500/20',
  Windows: 'bg-sky-500/10 text-sky-500 border-sky-500/20',
  Tools: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20',
  Research: 'bg-cyan-500/10 text-cyan-500 border-cyan-500/20',
};

const categoryColor = categoryColors[category] || 'bg-slate-500/10 text-slate-500 border-slate-500/20';
---

<article class="group relative flex flex-col bg-white dark:bg-[#0c101e] border border-slate-200/60 dark:border-slate-800/60 rounded-2xl overflow-hidden shadow-sm hover:shadow-md dark:hover:border-cyan-500/30 transition-all duration-300">
  <!-- Link wrapper -->
  <a href={`/blog/${post.id}`} class="absolute inset-0 z-10" aria-label={`Read ${title}`}></a>
  
  <!-- Image -->
  <div class="aspect-video w-full overflow-hidden bg-slate-100 dark:bg-slate-900 border-b border-slate-100 dark:border-slate-800/50">
    {heroImage ? (
      <img
        src={heroImage}
        alt={`Cover image for ${title}`}
        class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center bg-gradient-to-tr from-slate-100 to-slate-200 dark:from-slate-900 dark:to-slate-800">
        <span class="text-slate-400 text-sm">No cover image</span>
      </div>
    )}
  </div>

  <!-- Content -->
  <div class="flex-grow p-6 flex flex-col">
    <!-- Meta Info -->
    <div class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400 mb-3">
      <span class={`px-2.5 py-0.5 rounded-full border text-[11px] font-semibold tracking-wide uppercase ${categoryColor}`}>
        {category}
      </span>
      <span>&bull;</span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
      <span>&bull;</span>
      <span>{readingTime}</span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-bold text-slate-900 dark:text-white leading-snug group-hover:text-cyan-500 dark:group-hover:text-cyan-400 transition-colors mb-2">
      {title}
    </h3>

    <!-- Description -->
    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed mb-4 line-clamp-3">
      {description}
    </p>

    <!-- Footer / Tags -->
    <div class="mt-auto pt-4 border-t border-slate-100 dark:border-slate-800/50 flex flex-wrap gap-1.5 z-20">
      {tags.slice(0, 3).map((tag) => (
        <a
          href={`/blog?tag=${encodeURIComponent(tag)}`}
          class="text-xs px-2 py-1 rounded bg-slate-100 dark:bg-slate-800/60 hover:bg-cyan-500/10 hover:text-cyan-500 dark:hover:bg-cyan-500/15 dark:hover:text-cyan-400 text-slate-500 dark:text-slate-400 font-medium transition-colors"
        >
          #{tag}
        </a>
      ))}
      {tags.length > 3 && (
        <span class="text-xs text-slate-400 px-1 py-1 font-medium">+{tags.length - 3}</span>
      )}
    </div>
  </div>
</article>
